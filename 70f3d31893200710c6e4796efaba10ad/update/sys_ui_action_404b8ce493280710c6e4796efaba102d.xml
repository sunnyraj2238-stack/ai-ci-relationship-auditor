        <name>Approve &amp; Write to CMDB</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function() {
    var writer = new x_1412526_ai_ci_re.CIAudCMDBWriter();
    var relId = writer.writeRelationship(current.sys_id.toString());
    if (relId) {
        current.status = 'Approved';
        current.reviewed_by = gs.getUserID();
        current.reviewed_on = new GlideDateTime();
        current.update();
        gs.addInfoMessage('Relationship written to CMDB successfully. cmdb_rel_ci sys_id: ' + relId);
    } else {
        gs.addErrorMessage('Write failed or relationship already exists in CMDB. Check the CI Audit Log for details.');
    }
    action.setRedirectURL(current);
})();]]></script>
